# ---- Authentification (Auth.js) ----
# openssl rand -base64 32
AUTH_SECRET=
# Google Cloud > APIs et services > Identifiants > ID client OAuth (application Web)
# URI de redirection autorisée : https://<votre-domaine-vercel>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Domaines Google Workspace admis (séparés par des virgules)
ALLOWED_EMAIL_DOMAINS=firstblock.com

# ---- Claude (Anthropic) ----
ANTHROPIC_API_KEY=
# Facultatif. Par défaut : claude-opus-5-5
CLAUDE_MODEL=claude-opus-5-5

# ---- Zoho CRM (client « self-client », voir README) ----
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
# Centre de données de First Block (laisser tel quel)
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_API_URL=https://www.zohoapis.com
# true : quand une opportunité n'a pas de dossier Drive, l'application en crée un et inscrit son id dans le champ « Google drive » de Zoho
ZOHO_WRITE_DRIVE_ID=false

# ---- Google Drive ----
# Dossier (dans le Drive partagé) où créer les dossiers des visites sans opportunité ou des opportunités sans dossier
DRIVE_ROOT_FOLDER_ID=

# ---- Posées automatiquement par scripts/vercel-bootstrap.mjs ----
# SETUP_TOKEN : protège la page /setup (lien unique de mise en service)
# VERCEL_TOKEN, VERCEL_PROJECT_ID, VERCEL_TEAM_ID : permettent à /setup d'enregistrer les clés dans Vercel
# ADMIN_EMAILS : courriels qui peuvent rouvrir /setup après la mise en service
